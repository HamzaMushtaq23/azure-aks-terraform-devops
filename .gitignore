# Terraform working directory
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files
*.tfvars
*.tfvars.json

# Allow example variable files
!*.tfvars.example

# Environment / secret files
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# VS Code local settings
.vscode/